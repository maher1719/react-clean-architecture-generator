.relation-select { display:flex; flex-direction:column; gap:.4rem; min-width:0; }
.relation-select > label { font-size:.85rem; font-weight:600; }
.relation-select input[type="search"],.relation-select select { width:100%; min-height:2.5rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:.55rem .65rem; background:var(--color-surface); color:var(--color-text); }
.relation-selected { display:flex; flex-wrap:wrap; gap:.35rem; min-height:1.6rem; }
.relation-chip { display:inline-flex; align-items:center; gap:.35rem; max-width:100%; padding:.2rem .5rem; border-radius:999px; background:var(--color-bg); border:1px solid var(--color-border); font-size:.85rem; }
.relation-chip button { border:0; background:transparent; color:inherit; cursor:pointer; font-size:1rem; line-height:1; }
.relation-options { display:flex; flex-direction:column; gap:.2rem; max-height:11rem; overflow:auto; border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:.4rem; }
.relation-option { display:flex; align-items:center; gap:.5rem; padding:.3rem; border-radius:var(--radius-sm); cursor:pointer; font-weight:400!important; }
.relation-option:hover { background:var(--color-bg); }
.relation-clear { align-self:flex-start; }
.relation-error { color:#b91c1c; font-size:.85rem; }
