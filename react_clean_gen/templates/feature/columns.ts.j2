import type { {{ entity_name }} } from "../domain/{{ camel }}";
import type { DataTableColumn } from "../../../shared/ui/DataTable";
export type {{ pascal }}Column = DataTableColumn<{{ entity_name }}>;
export const {{ camel }}Columns: {{ pascal }}Column[] = [
{% for name in columns %}
{% set f = fields | selectattr("name", "equalto", name) | first %}
  { 
    key: "{{ f.name }}",
    label: {{ f.label | tojson }},
    type: {{ f.display_type | tojson }},
    sortable: {{ "true" if f.sortable else "false" }},
    filterable: {{ "true" if f.filterable else "false" }} 
    },
    
{% endfor %}
];
