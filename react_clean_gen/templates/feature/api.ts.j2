  if (query.sortDirection) p.set("sortDirection", query.sortDirection);
  if (query.search) p.set("search", query.search);
  for (const [key,value] of Object.entries(query.filters ?? {})) if (value !== null && value !== undefined) p.set(`filter[${key}]`, String(value));
