export function LoadingState({label="Loading…"}:{label?:string}) { return <div role="status" aria-live="polite" className="panel">{label}</div>; }
export function ErrorState({message,onRetry}:{message:string;onRetry?:()=>void}) { return <div role="alert" className="panel"><p>{message}</p>{onRetry ? <button onClick={onRetry}>Try again</button> : null}</div>; }
export function EmptyState({title="No results",description}:{title?:string;description?:string}) { return <div className="panel"><h2>{title}</h2>{description ? <p className="muted">{description}</p> : null}</div>; }
