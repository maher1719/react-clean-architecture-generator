:root {
  color-scheme: light;
  --color-bg: #f7f8fa; --color-surface: #fff; --color-text: #17202a;
  --color-muted: #5c6672; --color-border: #d9dfe5; --color-primary: #2457c5;
  --radius-sm: .25rem; --radius-md: .5rem; --space-1: .25rem; --space-2: .5rem;
  --space-3: .75rem; --space-4: 1rem; --space-6: 1.5rem;
  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
[data-theme="dark"] { color-scheme: dark; --color-bg:#12161c; --color-surface:#1c232c; --color-text:#eef2f6; --color-muted:#a5b0bd; --color-border:#37414e; --color-primary:#91b3ff; }
