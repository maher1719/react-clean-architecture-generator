* { box-sizing: border-box; }
html,body,#root { min-height:100%; margin:0; }
body { background:var(--color-bg); color:var(--color-text); font-family:var(--font-sans); }
button,input,select,textarea { font:inherit; }
a { color:inherit; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible { outline:2px solid var(--color-primary); outline-offset:2px; }
.app-shell { min-height:100vh; }
.app-header { display:flex; align-items:center; gap:var(--space-6); padding:var(--space-4) var(--space-6); background:var(--color-surface); border-bottom:1px solid var(--color-border); }
.app-brand { font-weight:700; text-decoration:none; }
nav { display:flex; flex-wrap:wrap; gap:var(--space-4); }
nav a { color:var(--color-muted); text-decoration:none; }
nav a.active { color:var(--color-primary); }
.app-content { padding:var(--space-6); }
.page { max-width:76rem; margin:0 auto; }
.page-heading { display:flex; align-items:center; justify-content:space-between; gap:var(--space-4); margin-bottom:var(--space-4); }
.page-heading h1 { margin:0 0 var(--space-2); }
.page-heading p { margin:0; }
.panel,.data-panel { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-md); padding:var(--space-4); }
.muted { color:var(--color-muted); }
.button { border:1px solid var(--color-primary); border-radius:var(--radius-sm); padding:.5rem .8rem; background:var(--color-primary); color:white; cursor:pointer; }
.button-secondary { background:var(--color-surface); color:var(--color-text); border-color:var(--color-border); }
.button:disabled { opacity:.45; cursor:not-allowed; }
.table-scroll { overflow-x:auto; }
.data-table { width:100%; border-collapse:collapse; text-align:left; }
.data-table th,.data-table td { padding:.85rem .75rem; border-bottom:1px solid var(--color-border); vertical-align:top; }
.data-table th { font-size:.85rem; color:var(--color-muted); font-weight:650; white-space:nowrap; }
.data-table tbody tr:last-child td { border-bottom:0; }
.data-table tbody tr:hover { background:color-mix(in srgb,var(--color-primary) 4%,var(--color-surface)); }
.table-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:var(--space-3); padding-top:var(--space-4); margin-top:var(--space-2); border-top:1px solid var(--color-border); }
.pagination-controls { display:flex; align-items:center; gap:var(--space-2); flex-wrap:wrap; }
.page-size { display:flex; align-items:center; gap:var(--space-2); font-size:.9rem; }
.page-size select { border:1px solid var(--color-border); background:var(--color-surface); color:var(--color-text); border-radius:var(--radius-sm); padding:.4rem; }
.inline-error { padding:var(--space-3); margin-bottom:var(--space-3); border:1px solid #d97777; border-radius:var(--radius-sm); }
.inline-error button { margin-left:var(--space-2); }
.row-actions { white-space:nowrap; }
@media (max-width:640px) { .app-header { align-items:flex-start; flex-direction:column; gap:var(--space-3); } .app-content { padding:var(--space-3); } .table-footer { align-items:flex-start; flex-direction:column; } .pagination-controls { align-items:flex-start; } }

.list-toolbar { display:flex; align-items:end; flex-wrap:wrap; gap:var(--space-3); margin-bottom:var(--space-4); }
.search-control,.filter-control,.form-field { display:flex; flex-direction:column; gap:.35rem; min-width:10rem; }
.search-control { flex:1 1 14rem; }
.search-control span,.filter-control span,.form-field span { font-size:.85rem; font-weight:600; }
.search-control input,.filter-control input,.filter-control select,.form-field input:not([type=checkbox]),.form-field textarea { width:100%; min-height:2.5rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:.55rem .65rem; background:var(--color-surface); color:var(--color-text); }
.form-field textarea { min-height:7rem; resize:vertical; }
.toolbar-actions,.form-actions { display:flex; align-items:center; flex-wrap:wrap; gap:var(--space-2); }
.form-panel { margin-top:var(--space-4); }
.form-panel h2 { margin:0; }
.entity-form { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr)); gap:var(--space-4); }
.form-actions,.form-error { grid-column:1/-1; }
.form-error { color:#b91c1c; }
.button-danger { background:#b91c1c; border-color:#b91c1c; margin-left:.35rem; }
@media(max-width:640px){ .list-toolbar { align-items:stretch; flex-direction:column; } .search-control,.filter-control { width:100%; } }
