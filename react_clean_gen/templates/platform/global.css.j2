* { box-sizing: border-box; } html,body,#root { min-height:100%; margin:0; }
body { background:var(--color-bg); color:var(--color-text); font-family:var(--font-sans); }
button,input,select,textarea { font:inherit; } a { color:inherit; }
.app-shell { min-height:100vh; } .app-header { display:flex; align-items:center; gap:var(--space-6); padding:var(--space-4) var(--space-6); background:var(--color-surface); border-bottom:1px solid var(--color-border); }
.app-brand { font-weight:700; text-decoration:none; } nav { display:flex; flex-wrap:wrap; gap:var(--space-4); } nav a { color:var(--color-muted); text-decoration:none; } nav a.active { color:var(--color-primary); }
.app-content { padding:var(--space-6); } .page { max-width:76rem; margin:0 auto; } .panel { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-md); padding:var(--space-4); } .muted { color:var(--color-muted); }
