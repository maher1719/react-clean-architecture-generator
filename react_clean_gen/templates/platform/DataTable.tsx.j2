import type { ReactNode } from "react";

export interface DataTableColumn<T> {
  key: keyof T & string;
  label: string;
  type: string;
  sortable?: boolean;
  filterable?: boolean;
}

export interface DataTableProps<T> {
  rows: T[];
  columns: DataTableColumn<T>[];
  rowKey: (row: T, index: number) => string;
  renderRowActions?: (row: T) => ReactNode;
  emptyLabel?: string;
}

function formatCell(value: unknown, type: string): string {
  if (value === null || value === undefined || value === "") return "—";
  if (type === "boolean" || typeof value === "boolean") return value ? "Yes" : "No";
  if (type === "date" || type === "datetime") {
    const date = new Date(String(value));
    if (Number.isNaN(date.getTime())) return String(value);
    return new Intl.DateTimeFormat(undefined, type === "date"
      ? { year: "numeric", month: "short", day: "numeric" }
      : { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }).format(date);
  }
  return String(value);
}

/** Reusable table presentation. Sorting/filtering are metadata only until wired to API behavior. */
export function DataTable<T>({ rows, columns, rowKey, renderRowActions, emptyLabel = "No rows" }: DataTableProps<T>) {
  if (rows.length === 0) return <p className="muted">{emptyLabel}</p>;
  return <div className="table-scroll">
    <table className="data-table">
      <thead>
        <tr>
          {columns.map((column) => <th scope="col" key={column.key}>{column.label}</th>)}
          {renderRowActions ? <th scope="col">Actions</th> : null}
        </tr>
      </thead>
      <tbody>{rows.map((row, index) => <tr key={rowKey(row, index)}>
        {columns.map((column) => <td key={column.key}>{formatCell(row[column.key], column.type)}</td>)}
        {renderRowActions ? <td className="row-actions">{renderRowActions(row)}</td> : null}
      </tr>)}</tbody>
    </table>
  </div>;
}
